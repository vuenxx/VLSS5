# ===================================================================
# Visual Studio / MSBuild C++ Ignore Rules
# ===================================================================

# Visual Studio temporary & user-specific files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb

# Build output directories
x64/
x86/
Win32/
ARM/
ARM64/
Debug/
Release/
ref/


# Project intermediate build folders
VLSS5/
v-graphic5/
[Bb]in/
[Oo]bj/
build/

# Compilation object files & debugging symbols
*.obj
*.iobj
*.ipdb
*.idb
*.pdb
*.ilk
*.tlog
*.recipe
*.res
*.pch
*.exp

# MSBuild logs & cleanup files
*.log
*.Build.CppClean.log
*.FileListAbsolute.txt

# Crash dumps & backups
*.dmp
*.bak
*.tmp

# CI'nin git tag'inden ureterek yazdigi surum header'i (bkz. src/Version.h,
# .github/workflows/release.yml) -- kasitli olarak commit'lenmez.
src/VersionGenerated.h

# ===================================================================
# Binaries & Proprietary NVIDIA Model Weights
# (nvngx_dlssnr.dll exceeds GitHub's 100MB limit)
# ===================================================================
*.exe
*.dll
*.rar
*.zip
*.7z

# redist/nvngx.dll_dlssnr.dll ISTISNA: kucuk (114KB), dagitilabilir bir
# yardimci DLL (OptiScaler_DLSSNR) -- her release'te zaten elle paylasilan
# dosya, Inno Setup installer'inin (installer/VLSS5.iss) paketleyebilmesi
# icin repoda tutuluyor. nvngx_dlssnr.dll (asil NGX model agirliklari,
# >100MB, telifli) HALA ignore edilir -- kullanici tarafindan ayrica temin
# edilmesi gerekir.
!redist/nvngx.dll_dlssnr.dll

# Runtime configuration & session logs
vlss5_config.ini
vlss5_dlss.log

# ===================================================================
# OS generated files
# ===================================================================
Thumbs.db
Desktop.ini
.DS_Store
